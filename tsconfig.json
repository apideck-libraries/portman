{
  "compilerOptions": {
    /* Basic Options */
    "target": "es2022",
    "module": "node20",
    "useDefineForClassFields": false,
    "skipLibCheck": true,
    "sourceMap": true,
    "removeComments": true,
    "declaration": true,
    "importHelpers": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "outDir": "./dist",
    /* Strict Type-Checking Options */
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    /* Additional Checks */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    /* Module Resolution Options */
    "rootDir": "./src",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    /* Experimental Options */
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "paths": {
      "src/*": ["./src/*"],
      "application": ["./src/application"],
      "utils": ["./src/utils"],
      "lib": ["./src/lib/"],
      "oas": ["./src/oas/"],
      "postman": ["./src/postman/"],
      "services": ["./src/services"],
      "types": ["./src/types/"]
    },
    "typeRoots": ["./node_modules/@types", "./src/types"],
    "types": ["node", "jest"]
  },
  "include": ["src", "src/**/*.ts"],
  "exclude": ["node_modules/**/*", ".vscode/**/*", "__tests__", "src/**/*.test.ts"]
}
